# Environment variables that Snippets reads. Every value is empty on purpose.
# The app runs with none of them: capture, the book, and export stay on the
# device. Copy the lines you need to .env.local, and never commit real values.

# --- Site ------------------------------------------------------------------------

# Canonical origin for metadata. Default: https://www.snippets.ink. Set it on previews.
NEXT_PUBLIC_SITE_URL=
# 1 sends the Content-Security-Policy as report-only, for an emergency.
CSP_REPORT_ONLY=
# Set by Vercel: production, preview, or development.
VERCEL_ENV=

# --- Accounts, sync, and Drive backup (optional) ----------------------------------

# Neon Postgres pooled connection URL. Without it, accounts are off.
DATABASE_URL=
# Better Auth signing secret, such as the output of: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Canonical origin that Better Auth uses for callbacks.
BETTER_AUTH_URL=
# Google OAuth client ID, for sign-in and the Drive grant.
GOOGLE_CLIENT_ID=
# Google OAuth client secret.
GOOGLE_CLIENT_SECRET=
# Resend API key, for sign-in codes and backup alerts.
RESEND_API_KEY=
# Sender address for those emails, on a domain that Resend verified.
RESEND_FROM=
# Secret that guards the daily /api/cron/backup watchdog.
CRON_SECRET=
# Optional: address that gets database storage alerts.
OPS_ALERT_EMAIL=

# --- Streaming speech providers (optional) ----------------------------------------

# Provider order. Default: soniox,speechmatics,deepgram. The first with a key wins.
NEXT_PUBLIC_SPEECH_PROVIDERS=
# Soniox API key. The server mints a temporary key for each recording.
SONIOX_API_KEY=
# Soniox realtime model. Default: stt-rt-v5.
SONIOX_MODEL=
# Language that Soniox expects, such as en. Default: none, so Soniox detects it.
SONIOX_LANGUAGE_HINTS=
# Lifetime of a Soniox temporary key, in seconds, kept within the limits in src/server/speech-guard.ts.
SONIOX_TOKEN_TTL=
# Soniox REST origin. Default: https://api.soniox.com.
SONIOX_REST_URL=
# Soniox WebSocket origin. Default: wss://stt-rt.soniox.com.
SONIOX_WS_URL=
# Speechmatics API key. The server mints a short-lived JWT for each recording.
SPEECHMATICS_API_KEY=
# Speechmatics language, one per session. Default: en.
SPEECHMATICS_LANGUAGE=
# Speechmatics operating point. Default: enhanced.
SPEECHMATICS_OPERATING_POINT=
# Optional Speechmatics region for the JWT.
SPEECHMATICS_REGION=
# Lifetime of a Speechmatics JWT, in seconds, kept within the limits in src/server/speech-guard.ts.
SPEECHMATICS_TOKEN_TTL=
# Speechmatics management origin. Default: https://mp.speechmatics.com.
SPEECHMATICS_MP_URL=
# Speechmatics realtime origin. Default: wss://eu2.rt.speechmatics.com/v2.
SPEECHMATICS_WS_URL=
# Deepgram API key. The server mints a short-lived JWT for each recording.
DEEPGRAM_API_KEY=
# Deepgram model. Default: nova-3.
DEEPGRAM_MODEL=
# Deepgram language. Default: multi.
DEEPGRAM_LANGUAGE=
# Lifetime of a Deepgram JWT, in seconds, kept within the limits in src/server/speech-guard.ts.
DEEPGRAM_TOKEN_TTL=
# Deepgram REST origin. Default: https://api.deepgram.com.
DEEPGRAM_REST_URL=
# Deepgram WebSocket origin. Default: wss://api.deepgram.com.
DEEPGRAM_WS_URL=
# Deepgram WebSocket origin for scripts/deepgram-live-test.mjs.
DEEPGRAM_BASE_URL=
# ElevenLabs API key, for Scribe. Outside the default order.
ELEVENLABS_API_KEY=
# ElevenLabs API origin. Default: https://api.elevenlabs.io.
ELEVENLABS_BASE_URL=
# Scribe model. Default: scribe_v2_realtime.
SCRIBE_MODEL=

# --- Batch speech fallback (optional) ----------------------------------------------

# Key for any service that speaks the OpenAI Whisper API.
TRANSCRIBE_API_KEY=
# Base URL of that service. Default: Aqua's https://api.aquavoice.com/api/v1.
TRANSCRIBE_BASE_URL=
# Model name. Default: avalon-v1.5.
TRANSCRIBE_MODEL=
# Older name for TRANSCRIBE_API_KEY.
AQUA_API_KEY=
# Older name for TRANSCRIBE_BASE_URL.
AQUA_BASE_URL=
# Older name for TRANSCRIBE_MODEL.
AQUA_MODEL=

# --- Verification and measurement tools ---------------------------------------------

# App origin that the Python harnesses open. Default: http://127.0.0.1:3000.
BASE_URL=
# App URL for the Appium scroll lane. Default: http://localhost:3000/calendar.
APP_URL=
# Appium server URL for the iOS lane.
APPIUM_URL=
# Simulator device name for the iOS lane. Default: iPhone 15.
DEVICE=
# Simulator iOS version for the iOS lane. Default: 17.5.
IOS=
# WebKitGTK WebDriver URL. Default: http://127.0.0.1:4599.
WEBKIT_WD=
# Firefox binary for the Gecko lane.
FIREFOX_BIN=
# Output folder for harness evidence. Default: /tmp/verify-snippets.
EVIDENCE_DIR=
# Output folder for the backup-failure screenshots.
BACKUP_SHOTS=
# Frame budget in ms that cdp_frames.py fails on. Default: no gate.
JANK_MS=
# Number of seeded entries for the measurement scripts. Default: 1200.
SNIPPETS_SEED=
# Number of seeded years for the dive measurement. Default: 6.
SNIPPETS_YEARS=
# Trials per case for the dive measurement. Default: 4.
DIVE_RASTER_TRIALS=
# Running app for the icon and image bake scripts, instead of starting next dev.
BAKE_URL=
# Port of the next dev server that the bake scripts start. Default: 3111.
BAKE_PORT=
# Chromium binary for the bake scripts.
PW_CHROME=
